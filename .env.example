# chat-recall — self-host environment
#
# Copy to `.env` beside docker-compose.yml. Only the two REQUIRED values below
# have to be set; everything else has a working default and is commented out.
#
#   cp .env.example .env
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" >> .env
#   echo "ADMIN_KEY=$(openssl rand -hex 24)"         >> .env
#   docker compose up -d --build
#
# Every variable here is one docker-compose.yml actually reads. If you add one,
# add it to the compose file too — a name that appears only here does nothing,
# which is how this template previously came to list six dead variables while
# omitting the single one that is mandatory.
#
# The reverse is not true, deliberately: compose also passes through the Stripe
# and billing variables, and they are NOT listed here. A self-hosted deployment
# never bills anyone, so naming STRIPE_SECRET_KEY in a self-host template only
# suggests it should. The hosted service supplies those from its own deployment,
# which is not in this repository.
#
# Not here on purpose: DATABASE_URL and CHAT_RECALL_STORAGE. Compose sets both
# itself from POSTGRES_PASSWORD, so setting them here achieves nothing. To use
# an external Postgres instead of the bundled one, override them in
# docker-compose.override.yml (see docs/SELF_HOSTING.md).

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Postgres superuser password for the bundled database. Compose refuses to start
# without it.
POSTGRES_PASSWORD=

# Creates tenants and mints device tokens. Treat it like a root password:
# anything holding it can read every tenant on this server.
ADMIN_KEY=

# ── Ports and storage ────────────────────────────────────────────────────────

# Host port for the dashboard and API. Default 8080.
#WEB_PORT=8080

# Where Postgres keeps its data on the host. Default /data/chat-recall/pg.
#PG_DATA_DIR=/data/chat-recall/pg

# ── Authentication ───────────────────────────────────────────────────────────

# `none` (default) is single-tenant with no login — right for a personal box on
# a trusted network. Bind the dashboard to localhost if you use it; see the
# override example in docs/SELF_HOSTING.md.
#AUTH_PROVIDER=none

# For OIDC instead. OIDC_ISSUER is also advertised to CLIs via /api/capabilities
# so `chat-recall login` can use SSO.
#OIDC_ISSUER=
#OIDC_JWKS_URL=
#OIDC_ALLOWED_AZP=

# ── Licence ──────────────────────────────────────────────────────────────────

# Self-hosting is free for one person, forever, with no key — the whole
# single-user product, task board and Toolkit included. A licence adds the
# collaboration features: a second member, shared history, assigning work to a
# teammate, and per-member activity. Verified offline against a key compiled into the
# server — no licence server is contacted, so air-gapped installs work and an
# outage on our side can never disable yours.
#
# Buy one self-serve from the account page of any chat-recall server you can
# reach (/app?view=account), then paste the CR1... key here and `docker compose
# up -d`. Priced per seat and billed from the second person, since the first is
# free. Full walkthrough: docs/SELF_HOSTING.md.
#CHAT_RECALL_LICENSE=

# Only for verifying keys signed by your own authority instead of ours.
#CHAT_RECALL_LICENSE_PUBKEY=

# ── Edition and features ─────────────────────────────────────────────────────

#CHAT_RECALL_EDITION=selfhost
#CHAT_RECALL_FEATURE_SECURITY=1

# ── AI summaries (optional) ──────────────────────────────────────────────────

# Unset means sessions carry no generated summary; everything else still works.
# Point it at Ollama, any OpenAI-compatible endpoint, or a CLI you are already
# logged in to.
#SUMMARY_PROVIDER=
#SUMMARY_BASE_URL=
#SUMMARY_MODEL=
#SUMMARY_API_KEY=

# ── Search (optional) ────────────────────────────────────────────────────────

# LLM query expansion. Off unless set.
#QUERY_EXPANSION=

# Vector search is configured on the SERVER container, not here — it needs an
# embedder reachable from inside Docker. See "Optional: semantic search" in
# docs/SELF_HOSTING.md for the docker-compose.override.yml snippet.
