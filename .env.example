# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Chat-Recall Configuration                                         ║
# ║  Copy this file to .env and edit as needed:  cp .env.example .env  ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Host AI Data Directories (Docker bind-mounts) ──────────────────────
# Docker Compose does NOT expand `~` — use ${HOME} or an absolute path.
# These are mounted read-only into the containers. Defaults below work as-is;
# override only if your tools live elsewhere.
CLAUDE_DIR=${HOME}/.claude
GEMINI_DIR=${HOME}/.gemini
CODEX_DIR=${HOME}/.codex
OPENCODE_DIR=${HOME}/.local/share/opencode

# ── Embedding Provider ──────────────────────────────────────────────────
# Used for semantic search (converting text to vectors).
#
# ollama  - Local, free, no API key needed. Requires Ollama running.
#           Uses nomic-embed-text model (768 dimensions, ~270MB).
#           Best for: privacy, offline use, no API costs.
#
# gemini  - Google API. Requires GEMINI_API_KEY.
#           Uses text-embedding-004 (768 dimensions).
#           Best for: higher quality embeddings, no local GPU.
#
EMBEDDING_PROVIDER=ollama

# ── Summary Provider ───────────────────────────────────────────────────
# Used for generating session summaries (optional but recommended).
#
# cli         - Shell out to any local coding-assistant CLI you already
#               have authed. No API key needed. Configure via
#               SUMMARY_CLI_PRESET (easy) or SUMMARY_CLI_CMD (custom).
#               Best for: zero-key setup reusing existing CLI auth.
#
# gemini-cli  - Legacy alias for the Gemini CLI (same as cli+preset=gemini).
#
# ollama      - Local chat model via Ollama API.
#               Requires: `ollama pull <chat-model>` first. Set
#               OLLAMA_SUMMARY_MODEL to choose.
#
# claude      - Anthropic HTTP API. Requires ANTHROPIC_API_KEY.
#
# openai-compat / ollama-cloud / openai / nvidia
#             - OpenAI-compatible HTTP API (one /chat/completions backend).
#               Covers OpenRouter, Ollama Cloud, NVIDIA NIM, OpenAI, Groq, etc.
#               Set SUMMARY_API_BASE_URL + SUMMARY_API_MODEL + SUMMARY_API_KEY.
#               RECOMMENDED for Docker — the local CLIs (gemini/opencode/kilocode)
#               do NOT work headless (they hang with no TTY).
#
SUMMARY_PROVIDER=gemini-cli

# OpenAI-compatible summary provider (when SUMMARY_PROVIDER is one of the
# openai-compat family). Examples:
#   OpenRouter:    https://openrouter.ai/api/v1   + a key from openrouter.ai/keys
#   Ollama Cloud:  https://ollama.com/v1          + a key from ollama.com
#   NVIDIA NIM:    https://integrate.api.nvidia.com/v1 + nvapi-… from build.nvidia.com
# SUMMARY_API_BASE_URL=
# SUMMARY_API_MODEL=
# SUMMARY_API_KEY=

# ── Summary CLI Provider (when SUMMARY_PROVIDER=cli) ───────────────────
# Pick a preset by name, or set a fully-custom command. Presets expand to
# known-good invocations; SUMMARY_CLI_CMD overrides a preset if both set.
#
# Built-in presets:
#   opencode     → opencode run "$(cat {prompt_file})"
#   kilo         → kilo run "$(cat {prompt_file})"
#   kilocode     → kilocode run "$(cat {prompt_file})"
#   gemini       → gemini -p " "                    (prompt piped on stdin)
#   claude-cli   → claude -p " "                    (prompt piped on stdin)
#   llm          → llm --no-stream                  (prompt piped on stdin)
#   aichat       → aichat --no-stream               (prompt piped on stdin)
#
# SUMMARY_CLI_PRESET=opencode
#
# Fully-custom command. Use `{prompt_file}` where the CLI wants the prompt
# as a file path / positional arg; omit the placeholder to pipe via stdin:
#   SUMMARY_CLI_CMD='opencode run "$(cat {prompt_file})"'
#   SUMMARY_CLI_CMD='gemini -p " "'
#
# Timeout for a single summary call (ms). Default 120000.
# SUMMARY_CLI_TIMEOUT_MS=120000

# ── Ollama Settings ────────────────────────────────────────────────────
# Host URL for the Ollama API.
# - For Docker: http://ollama:11434 (container name, set automatically)
# - For local/host Ollama: http://localhost:11434
# - For host Ollama from Docker: http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434

# Chat model for summaries (only used when SUMMARY_PROVIDER=ollama).
# Popular options: qwen2.5:7b, llama3.2:3b, mistral:7b, gemma2:9b
# Smaller models (3b) are faster; larger models (7b+) are more accurate.
OLLAMA_SUMMARY_MODEL=qwen2.5:7b

# ── API Keys (only needed for API-based providers) ─────────────────────
# Gemini API key - get one at https://aistudio.google.com/apikey
# Required when: EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=

# Anthropic API key - get one at https://console.anthropic.com/
# Required when: SUMMARY_PROVIDER=claude
# ANTHROPIC_API_KEY=

# ── Model Overrides ────────────────────────────────────────────────────
# Gemini model for summaries (when SUMMARY_PROVIDER=gemini-cli)
# GEMINI_MODEL=gemini-3-flash-preview

# ── AI Tool Sessions ────────────────────────────────────────────────────
# Chat-recall automatically discovers sessions from:
#   - Claude Code: ~/.claude/projects/ and ~/.claude-*/projects/
#   - Gemini CLI:  ~/.gemini/tmp/*/chats/session-*.json
#   - OpenCode:    ~/.local/share/opencode/opencode.db
#
# All discovered tools are indexed and searchable together.
# No configuration needed — they're auto-detected.

# ── Port Configuration ─────────────────────────────────────────────────
# Web UI port (nginx)
WEB_PORT=8080

# Backend API port
API_PORT=5000

# Ollama port (if using the bundled container)
OLLAMA_PORT=11434

# ── Storage backend (sqlite default, postgres for team/cloud) ──────────
# sqlite = local single-user (default, zero deps). postgres = team/cloud,
# multi-tenant. For postgres: `docker compose --profile postgres up`.
CHAT_RECALL_STORAGE=sqlite
# DATABASE_URL=postgres://chatrecall:chatrecall@postgres:5432/chat_recall
# CHAT_RECALL_TENANT=default
# POSTGRES_USER=chatrecall
# POSTGRES_PASSWORD=chatrecall
# POSTGRES_DB=chat_recall
# POSTGRES_PORT=5432
