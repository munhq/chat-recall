{
  "version": 1,
  "github": "munhq/chat-recall",
  "store": "server",
  "server": {
    "url": "https://desk.munhq.com",
    "tokenEnv": "DESK_TOKEN"
  },
  "release": {
    "versionFile": "packages/cli/package.json"
  },
  "checkouts": [
    {
      "repo": "munhq/chat-recall-site",
      "path": "site-src"
    },
    {
      "repo": "munhq/web-standards",
      "path": "web-standards"
    },
    {
      "repo": "munhq/desk",
      "path": ".desk/workflows/buck-base",
      "at": 575,
      "subpath": "workflows/buck-base"
    },
    {
      "repo": "munhq/desk",
      "path": ".desk/workflows/buck-node",
      "at": 575,
      "subpath": "workflows/buck-node"
    }
  ],
  "images": [
    {
      "name": "selfhost",
      "image": "ghcr.io/munhq/chat-recall",
      "dockerfile": "docker/Dockerfile.server",
      "context": ".",
      "changeArg": "GIT_SHA",
      "secrets": [
        "npmtoken"
      ],
      "tags": [
        "latest",
        "main"
      ],
      "timeoutMinutes": 45
    },
    {
      "name": "cloud",
      "image": "ghcr.io/munhq/chat-recall-cloud",
      "dockerfile": "docker/Dockerfile.server",
      "context": ".",
      "target": "cloud",
      "args": {
        "VITE_CLOUD": "1",
        "OPENAI_APPS_CHALLENGE": "hC6GpWiSrnfYr34L0vC8otCzbMzCJXoX7ZgXHlEbbbw"
      },
      "changeArg": "GIT_SHA",
      "secrets": [
        "npmtoken",
        "privatenames",
        "glitchtipdsn"
      ],
      "tags": [
        "main"
      ],
      "timeoutMinutes": 45
    }
  ],
  "validation": [
    {
      "name": "root",
      "command": "sh .desk/workflows/buck-base/scripts/buck-run.sh build //:check",
      "secrets": {
        "NODE_AUTH_TOKEN": "npmtoken"
      },
      "timeoutMinutes": 30,
      "paths": [
        "packages/**",
        "package.json",
        "package-lock.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "vitest.config.ts",
        "vitest.setup.ts",
        "vitest.global-setup.ts",
        "scripts/**",
        "BUCK",
        ".buckconfig",
        ".desk/config.json"
      ]
    },
    {
      "name": "modules",
      "setup": "sh scripts/ci-install.sh",
      "command": "npx marketing-kit modules .",
      "paths": [
        "package.json",
        "package-lock.json",
        "packages/*/package.json",
        "packages/server/src/auth/**",
        "packages/server/src/routes/mcp.ts",
        "packages/server/src/util/auth-kit.ts",
        "scripts/ci-install.sh"
      ],
      "secrets": {
        "NODE_AUTH_TOKEN": "npmtoken"
      },
      "timeoutMinutes": 15
    }
  ],
  "preLand": [
    "{ [ -d node_modules ] || npm ci --no-audit --no-fund; } && npx tsc -b --pretty false",
    "cd packages/server/client && { [ -d node_modules ] || npm ci --no-audit --no-fund; } && npx tsc -b --pretty false"
  ],
  "budget": {
    "mode": "refuse",
    "checkSeconds": 60,
    "checks": {}
  }
}
