{
  "version": 1,
  "github": "munhq/chat-recall",
  "store": "server",
  "server": {
    "url": "https://desk.munhq.com",
    "tokenEnv": "DESK_TOKEN"
  },
  "release": {
    "versionFile": "packages/cli/package.json"
  },
  "checkouts": [
    {
      "repo": "munhq/chat-recall-site",
      "path": "site-src"
    },
    {
      "repo": "munhq/web-standards",
      "path": "web-standards"
    },
    {
      "repo": "munhq/desk",
      "path": ".desk/workflows/buck-base",
      "at": 594,
      "subpath": "workflows/buck-base"
    },
    {
      "repo": "munhq/desk",
      "path": ".desk/workflows/buck-node",
      "at": 594,
      "subpath": "workflows/buck-node"
    }
  ],
  "images": [
    {
      "name": "selfhost",
      "image": "ghcr.io/munhq/chat-recall",
      "changeArg": "GIT_SHA",
      "secrets": [
        "npmtoken"
      ],
      "tags": [
        "latest",
        "main"
      ],
      "timeoutMinutes": 45,
      "base": "mirror.gcr.io/library/node:24-bookworm@sha256:9d266751ca3d7fdbe651c878ffd5ad0a42fed49a18c283509267c97f025b7496",
      "build": "sh scripts/image-selfhost.sh",
      "workdir": "/app",
      "cmd": [
        "node",
        "packages/server/dist/server.js"
      ],
      "env": {
        "NODE_ENV": "production",
        "HOST": "0.0.0.0",
        "PORT": "5000",
        "CHAT_RECALL_SERVER_MODE": "server",
        "CHAT_RECALL_DATA_DIR": "/data",
        "STATIC_DIR": "/app/client",
        "BUILD_STAMP_FILE": "/app/.build-stamp"
      },
      "paths": [
        ".buckconfig",
        "BUCK",
        "README.md",
        "package-lock.json",
        "package.json",
        "packages/**",
        "scripts/image-selfhost.sh",
        "tsconfig.base.json",
        "tsconfig.json"
      ]
    },
    {
      "name": "cloud",
      "image": "ghcr.io/munhq/chat-recall-cloud",
      "changeArg": "GIT_SHA",
      "secrets": [
        "npmtoken",
        "privatenames",
        "glitchtipdsn"
      ],
      "tags": [
        "main"
      ],
      "timeoutMinutes": 45,
      "base": "mirror.gcr.io/library/node:24-bookworm@sha256:9d266751ca3d7fdbe651c878ffd5ad0a42fed49a18c283509267c97f025b7496",
      "build": "sh scripts/image-cloud.sh",
      "workdir": "/app",
      "cmd": [
        "node",
        "packages/server/dist/server.js"
      ],
      "env": {
        "NODE_ENV": "production",
        "HOST": "0.0.0.0",
        "PORT": "5000",
        "CHAT_RECALL_SERVER_MODE": "server",
        "CHAT_RECALL_DATA_DIR": "/data",
        "STATIC_DIR": "/app/client",
        "BUILD_STAMP_FILE": "/app/.build-stamp"
      },
      "paths": [
        ".buckconfig",
        "BUCK",
        "README.md",
        "docs/**",
        "package-lock.json",
        "package.json",
        "packages/**",
        "scripts/dump-reference.mjs",
        "scripts/image-cloud.sh",
        "scripts/mounts-hash.sh",
        "site-src/**",
        "tsconfig.base.json",
        "tsconfig.json",
        "web-standards/bin/**"
      ]
    }
  ],
  "validation": [
    {
      "name": "root",
      "command": "sh .desk/workflows/buck-base/scripts/buck-run.sh build //:check",
      "secrets": {
        "NODE_AUTH_TOKEN": "npmtoken"
      },
      "timeoutMinutes": 30,
      "paths": [
        "packages/**",
        "package.json",
        "package-lock.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "vitest.config.ts",
        "vitest.setup.ts",
        "vitest.global-setup.ts",
        "scripts/**",
        "BUCK",
        ".buckconfig",
        ".desk/config.json"
      ]
    },
    {
      "name": "selfhost",
      "command": "sh .desk/workflows/buck-base/scripts/buck-run.sh build //:selfhost-image",
      "secrets": {
        "NODE_AUTH_TOKEN": "npmtoken"
      },
      "timeoutMinutes": 30,
      "paths": [
        "packages/**",
        "package.json",
        "package-lock.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "vitest.config.ts",
        "vitest.setup.ts",
        "vitest.global-setup.ts",
        "scripts/**",
        "BUCK",
        ".buckconfig",
        ".desk/config.json"
      ]
    },
    {
      "name": "modules",
      "command": "sh .desk/workflows/buck-base/scripts/buck-run.sh build //:modules",
      "paths": [
        ".buckconfig",
        "BUCK",
        "package-lock.json",
        "package.json",
        "packages/*/package.json",
        "packages/server/src/auth/**",
        "packages/server/src/routes/mcp.ts",
        "packages/server/src/util/auth-kit.ts",
        "scripts/ci-install.sh"
      ],
      "secrets": {
        "NODE_AUTH_TOKEN": "npmtoken"
      },
      "timeoutMinutes": 15
    },
    {
      "name": "cloud",
      "command": "sh .desk/workflows/buck-base/scripts/buck-run.sh build $(sh scripts/mounts-hash.sh) //:cloud-image",
      "secrets": {
        "NODE_AUTH_TOKEN": "npmtoken",
        "CHAT_RECALL_PRIVATE_NAMES": "privatenames",
        "VITE_GLITCHTIP_DSN": "glitchtipdsn"
      },
      "timeoutMinutes": 40,
      "paths": [
        "packages/**",
        "site-src/**",
        "web-standards/bin/**",
        "docs/**",
        "README.md",
        "BUCK",
        ".buckconfig",
        ".desk/config.json"
      ]
    }
  ],
  "preLand": [
    "{ [ -d node_modules ] || npm ci --no-audit --no-fund; } && npx tsc -b --pretty false",
    "cd packages/server/client && { [ -d node_modules ] || npm ci --no-audit --no-fund; } && npx tsc -b --pretty false"
  ],
  "budget": {
    "mode": "refuse",
    "checkSeconds": 60,
    "checks": {}
  }
}
