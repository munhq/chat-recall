{
  "version": 1,
  "github": "munhq/chat-recall",
  "store": "server",
  "server": {
    "url": "https://desk.munhq.com",
    "tokenEnv": "DESK_TOKEN"
  },
  "release": {
    "versionFile": "packages/cli/package.json"
  },
  "checkouts": [
    {
      "repo": "munhq/chat-recall-site",
      "path": "site-src"
    },
    {
      "repo": "munhq/web-standards",
      "path": "web-standards"
    }
  ],
  "images": [
    {
      "name": "selfhost",
      "image": "ghcr.io/munhq/chat-recall",
      "dockerfile": "docker/Dockerfile.server",
      "context": ".",
      "changeArg": "GIT_SHA",
      "secrets": [
        "npmtoken"
      ],
      "tags": [
        "latest",
        "main"
      ],
      "timeoutMinutes": 45
    },
    {
      "name": "cloud",
      "image": "ghcr.io/munhq/chat-recall-cloud",
      "dockerfile": "docker/Dockerfile.server",
      "context": ".",
      "target": "cloud",
      "args": {
        "VITE_CLOUD": "1",
        "OPENAI_APPS_CHALLENGE": "hC6GpWiSrnfYr34L0vC8otCzbMzCJXoX7ZgXHlEbbbw"
      },
      "changeArg": "GIT_SHA",
      "secrets": [
        "npmtoken",
        "privatenames",
        "glitchtipdsn"
      ],
      "tags": [
        "main"
      ],
      "timeoutMinutes": 45
    }
  ],
  "validation": [
    {
      "name": "packages/cli:syntax",
      "command": "find . -name node_modules -prune -o \\( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \\) -print0 | xargs -0 -r -n1 node --check",
      "cwd": "packages/cli",
      "stage": "land",
      "paths": [
        "packages/cli/**/*.js",
        "packages/cli/**/*.mjs",
        "packages/cli/**/*.cjs",
        "packages/cli/package.json"
      ]
    },
    {
      "name": "packages/engine:syntax",
      "command": "find . -name node_modules -prune -o \\( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \\) -print0 | xargs -0 -r -n1 node --check",
      "cwd": "packages/engine",
      "stage": "land",
      "paths": [
        "packages/engine/**/*.js",
        "packages/engine/**/*.mjs",
        "packages/engine/**/*.cjs",
        "packages/engine/package.json"
      ]
    },
    {
      "name": "packages/server:syntax",
      "command": "find . -name node_modules -prune -o \\( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \\) -print0 | xargs -0 -r -n1 node --check",
      "cwd": "packages/server",
      "stage": "land",
      "paths": [
        "packages/server/**/*.js",
        "packages/server/**/*.mjs",
        "packages/server/**/*.cjs",
        "packages/server/package.json"
      ]
    },
    {
      "name": "packages/engine:test",
      "setup": "npm ci -w packages/cli -w packages/engine --include-workspace-root --no-audit --no-fund",
      "command": "npx vitest run packages/engine",
      "paths": [
        "packages/engine/**",
        "packages/cli/package.json",
        "package.json",
        "package-lock.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "vitest.config.ts",
        "vitest.setup.ts",
        "vitest.global-setup.ts"
      ],
      "timeoutMinutes": 30
    },
    {
      "name": "packages/cli:test",
      "setup": "npm ci -w packages/cli -w packages/engine --include-workspace-root --no-audit --no-fund && npm run build:public",
      "command": "npx vitest run packages/cli",
      "paths": [
        "packages/cli/**",
        "packages/engine/**",
        "package.json",
        "package-lock.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "vitest.config.ts",
        "vitest.setup.ts",
        "vitest.global-setup.ts",
        "scripts/build-plugin.mjs"
      ],
      "timeoutMinutes": 30
    },
    {
      "name": "packages/server:test",
      "setup": "npm ci --no-audit --no-fund",
      "command": "npx vitest run packages/server",
      "paths": [
        "packages/server/**",
        "packages/engine/**",
        "package.json",
        "package-lock.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "vitest.config.ts",
        "vitest.setup.ts",
        "vitest.global-setup.ts"
      ],
      "secrets": {
        "NODE_AUTH_TOKEN": "npmtoken"
      },
      "timeoutMinutes": 30
    },
    {
      "name": "modules",
      "setup": "npm ci --no-audit --no-fund",
      "command": "npx marketing-kit modules .",
      "paths": [
        "package.json",
        "package-lock.json",
        "packages/*/package.json",
        "packages/server/src/auth/**",
        "packages/server/src/routes/mcp.ts",
        "packages/server/src/util/auth-kit.ts"
      ],
      "secrets": {
        "NODE_AUTH_TOKEN": "npmtoken"
      },
      "timeoutMinutes": 15
    }
  ],
  "preLand": [
    "{ [ -d node_modules ] || npm ci --no-audit --no-fund; } && npx tsc -b --pretty false",
    "cd packages/server/client && { [ -d node_modules ] || npm ci --no-audit --no-fund; } && npx tsc -b --pretty false"
  ]
}
