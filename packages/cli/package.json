{
  "name": "chat-recall",
  "version": "0.3.2",
  "description": "Local-first memory for AI coding tools — indexes Claude Code / Gemini CLI / OpenCode / Codex sessions, exposes them over MCP, optionally syncs redacted history to a chat-recall server",
  "type": "module",
  "license": "MIT",
  "bin": {
    "chat-recall": "./dist/cli.js",
    "chat-recall-mcp": "./dist/mcp.js",
    "chat-recall-watch": "./dist/watch.js"
  },
  "files": [
    "dist",
    "hooks",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle.mjs && node scripts/postbuild.mjs",
    "build:types": "tsc -b",
    "auto-indexer": "tsx auto-indexer/indexer.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^12.0.0",
    "diff": "^9.0.0",
    "dotenv": "^17.2.3",
    "zod": "^3.22.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "12.9.0"
  },
  "devDependencies": {
    "@chat-recall/engine": "*"
  }
}
