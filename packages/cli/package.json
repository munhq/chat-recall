{
  "name": "chat-recall",
  "version": "0.5.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munhq/chat-recall.git"
  },
  "homepage": "https://chatrecall.dev",
  "bugs": {
    "url": "https://github.com/munhq/chat-recall/issues"
  },
  "description": "One memory across every AI coding tool \u2014 indexes Claude Code, Gemini CLI, Codex, OpenCode, Antigravity and Cursor sessions, redacts secrets, and exposes them to your agent over MCP.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "claude",
    "gemini-cli",
    "codex",
    "opencode",
    "antigravity",
    "cursor",
    "agent-memory",
    "ai-agents",
    "memory",
    "semantic-search",
    "developer-tools",
    "llm"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "Elastic-2.0",
  "bin": {
    "chat-recall": "./dist/cli.js",
    "chat-recall-mcp": "./dist/mcp.js",
    "chat-recall-watch": "./dist/watch.js"
  },
  "files": [
    "dist",
    "hooks",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md','README.md')\"",
    "build": "tsc -b && tsc -p tsconfig.daemon.json && node scripts/bundle.mjs && node scripts/postbuild.mjs",
    "build:types": "tsc -b",
    "auto-indexer": "tsx auto-indexer/indexer.ts",
    "typecheck:daemon": "tsc -p tsconfig.daemon.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^12.0.0",
    "diff": "^9.0.0",
    "dotenv": "^17.2.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@chat-recall/engine": "*",
    "better-sqlite3": "12.9.0"
  },
  "mcpName": "io.github.munhq/chat-recall"
}
