{
  "name": "chat-recall-monorepo",
  "version": "0.3.3",
  "description": "Cross-tool memory + MCP for Claude Code, Gemini CLI, and OpenCode sessions",
  "private": true,
  "type": "module",
  "author": "darkkraft",
  "homepage": "https://github.com/darkkraft/chat-recall#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/darkkraft/chat-recall.git"
  },
  "workspaces": [
    "packages/engine",
    "packages/cli",
    "packages/server"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w chat-recall",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "web:server:dev": "npm run dev -w @chat-recall/server",
    "web:server:build": "npm run build -w @chat-recall/server",
    "web:client:dev": "cd packages/server/client && npm run dev",
    "web:client:build": "cd packages/server/client && npm run build",
    "web:dev": "concurrently \"npm run web:server:dev\" \"npm run web:client:dev\"",
    "web:build": "npm run web:server:build && npm run web:client:build",
    "web:install": "cd packages/server/client && npm install",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@types/express": "^4.17.21"
  },
  "license": "SEE LICENSE IN packages/*/LICENSE",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^8.2.2",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  }
}
