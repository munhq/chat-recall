# @munhq packages live in GitHub Packages, not on npmjs.
#
# Only the SCOPE is redirected; everything else still comes from the public
# registry, so a clone with no token installs the whole project apart from the
# optional @munhq one.
#
# Mail is a hosted-service feature: @munhq/mailkit is an optionalDependency and
# `npm ci --omit=optional` needs no credential at all. That is what the public
# image and a self-host build use.
#
# CI authenticates with the workflow's own GITHUB_TOKEN via NODE_AUTH_TOKEN.
@munhq:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
