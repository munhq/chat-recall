# The chat-recall SERVER image (BSL) — one image, two deployments:
#   self-host:  docker compose up      (MODE=server, sqlite in a volume)
#   SaaS:       k8s via GitOps         (MODE=server, postgres + RLS, keycloak)
#
# Server mode means store-only: data arrives exclusively through /api/sync
# from the chat-recall local binary. No host AI-tool mounts, no in-container
# indexer — that was the retired docker-as-local design.

# ── Stage 0: compile the engine's shared modules ──────────────────────────────
# The client imports the shared secret classifier from @chat-recall/engine
# (single source of truth with the server). Build the engine's dist here so the
# isolated client stage can resolve that subpath exactly like the dev tree does
# (via node_modules/@chat-recall/engine), with no barrel/Node deps pulled in.
FROM node:20-bookworm-slim AS enginebuild
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/engine/package.json ./packages/engine/
COPY packages/cli/package.json ./packages/cli/
COPY packages/server/package.json ./packages/server/
RUN npm ci
COPY packages/engine/ ./packages/engine/
RUN npx tsc -b packages/engine

# ── Stage 1: build the React client → static dist ─────────────────────────────
FROM node:20-bookworm-slim AS client
WORKDIR /client
COPY packages/server/client/package.json packages/server/client/package-lock.json* ./
RUN npm ci || npm install
COPY packages/server/client/ ./
# Provide the compiled engine as a resolvable package so Vite bundles the shared
# classifier (only the pure subpath is imported — no engine barrel).
COPY --from=enginebuild /app/packages/engine/package.json ./node_modules/@chat-recall/engine/package.json
COPY --from=enginebuild /app/packages/engine/dist ./node_modules/@chat-recall/engine/dist
# Vite bakes these at build time. Unset (compose default) → same-origin /api,
# no external auth. The SaaS build passes the Keycloak issuer + client id.
ARG VITE_OIDC_ISSUER
ARG VITE_OIDC_CLIENT_ID
ARG VITE_API_BASE
# GlitchTip DSN for browser crash reporting (shared munhq-frontend project).
# Public key, baked into the client bundle; Vite reads it from the env.
ARG VITE_GLITCHTIP_DSN
ENV VITE_GLITCHTIP_DSN=$VITE_GLITCHTIP_DSN
RUN npm run build

# ── Stage 2: compile the TypeScript workspaces ────────────────────────────────
FROM node:20-bookworm-slim AS build
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/engine/package.json ./packages/engine/
COPY packages/cli/package.json ./packages/cli/
COPY packages/server/package.json ./packages/server/
RUN npm ci
COPY packages/engine/ ./packages/engine/
COPY packages/server/ ./packages/server/
COPY packages/cli/ ./packages/cli/
# Build server + engine, then build AND `npm pack` the CLI: the tarball is
# served by this same server at /install/chat-recall.tgz (routes/install.ts),
# so every deployment hands out a CLI that exactly matches its own version —
# no npm-registry publish in the loop. Pack BEFORE prune (the CLI build needs
# devDeps: tsc + esbuild).
RUN npx tsc -b packages/engine packages/server \
    && npm run build --workspace=chat-recall \
    && npm pack --workspace=chat-recall --pack-destination /app \
    && mv /app/chat-recall-*.tgz /app/chat-recall.tgz \
    && node -p "require('./packages/cli/package.json').version" > /app/cli-version.txt \
    && npm prune --omit=dev

# ── Stage 3: runtime ──────────────────────────────────────────────────────────
FROM node:20-bookworm-slim
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Production node_modules only (native modules were compiled in stage 2's
# npm ci with the toolchain present; copying them over keeps the runtime
# image free of python3/make/g++).
COPY package.json package-lock.json ./
COPY packages/engine/package.json ./packages/engine/
COPY packages/server/package.json ./packages/server/
COPY --from=build /app/node_modules ./node_modules

# Compiled JS + the engine workspace the server resolves via the symlink.
COPY --from=build /app/packages/engine/dist ./packages/engine/dist
COPY --from=build /app/packages/server/dist ./packages/server/dist

# The built SPA, served same-origin from STATIC_DIR.
COPY --from=client /client/dist ./client

# Migration runner + SQL — the k8s migrate initContainer runs
# `node migrate/migrate.mjs` from this same image (pg comes from node_modules).
COPY packages/server/cloud/migrate.mjs ./migrate/migrate.mjs
COPY packages/server/cloud/migrations ./migrate/migrations

# The packed CLI, served at /install/chat-recall.tgz (see routes/install.ts).
# cli-version.txt lets /api/capabilities advertise the packed CLI version so
# installed clients can self-update (util/cli-release.ts).
COPY --from=build /app/chat-recall.tgz ./install/chat-recall.tgz
COPY --from=build /app/cli-version.txt ./install/cli-version.txt

# Build stamp for /health's `build` field — answers "did the deploy actually
# roll?" without any CI plumbing. GIT_SHA is optional (CI can pass it); the
# UTC build time is always stamped so every image build is distinguishable.
ARG GIT_SHA=""
RUN printf '%s' "${GIT_SHA:-$(date -u +%Y%m%dT%H%M%SZ)}" > /app/.build-stamp
ENV BUILD_STAMP_FILE=/app/.build-stamp

EXPOSE 5000
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=5000
ENV CHAT_RECALL_SERVER_MODE=server
ENV CHAT_RECALL_DATA_DIR=/data
ENV STATIC_DIR=/app/client

CMD ["node", "packages/server/dist/server.js"]
